# ──────────────────────────────────────────────────────────────
# 9exp-genesis-lab — Environment variables
# Copy this file to .env.local and fill in real values.
# Never commit .env.local to git.
# ──────────────────────────────────────────────────────────────

# ── NextAuth ──────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=

# Base URL of the app (used by NextAuth for callbacks)
# Dev: http://localhost:3000
# Prod: https://www.9experttraining.com
AUTH_URL=http://localhost:3000

# ── MongoDB (internal data — admin, banners, articles, registrations) ──
# Pool size is set in src/lib/db/connect.js (maxPoolSize: 5) — that is the
# source of truth. Free Tier (M0) caps the cluster at 500 connections, so we
# keep 5 per serverless instance; bump connect.js to 10-20 after upgrading to
# M10. You can also pin it in the URI below as documentation/belt-and-braces.
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>/<dbname>?retryWrites=true&w=majority&maxPoolSize=5
MONGODB_DB_NAME=9exp_genesis

# ── External API (read-only course/schedule/career data) ──────
AI_API_BASE=https://9exp-sec.com/api/ai
AI_API_KEY=

# ── AI chat widget (two SEPARATE Cloud Run services) ──────────
# Base URL of the chatbot service. /api/chat proxies to
# <base>/api/chat?backend=langchain — the browser never talks to this
# host directly, which is why `connect-src 'self'` in next.config.mjs
# needs no widening for the chat feature.
#
# THIS KEY IS THE FEATURE FLAG. The root layout reads it server-side and
# the chat launcher is not rendered at all when it is empty, so a fresh
# clone ships no dead button. Leave it blank until you have the URL —
# ask the team; the value is a
#   https://expert-chatbot-api-<project>.<region>.run.app
# Cloud Run endpoint and is deliberately not committed here.
CHATBOT_V2_API_URL=

# Base URL of the feedback service — a DIFFERENT Cloud Run service from
# the chatbot above (thumbs up/down on an answer lands here, not there).
# Accepts either a bare host or a full .../api/feedback endpoint.
#
# Unset is a SUPPORTED state and is not the same as the chat being off:
# the widget still works and /api/chat/feedback answers
# { ok: true, forwarded: false } so a rating never surfaces an error to
# the user. Set it only when you want the ratings actually recorded.
FEEDBACK_API_URL=

# ── Admin chat panel (genesis → chatbot, server-to-server) ────
# Base URL of the chatbot service's PANEL API (GET /api/panel/*) and the key
# it expects in x-api-key. Read ONLY by src/lib/chatPanel/client.js, which is
# `server-only`: neither value ever reaches a browser bundle, and there is no
# NEXT_PUBLIC_ spelling of either (test/fs/chatPanelBundleGuard enforces both).
# Generate the key with:
#   openssl rand -base64 32
# The same value must be configured on the chatbot service. The direction is
# the REVERSE of CORPUS_API_KEY below — do not reuse that key.
#
# Unset (either one) is a SUPPORTED state: /admin/chat renders a
# "not configured" notice and makes no request. Nothing crashes.
CHAT_PANEL_API_URL=
CHAT_PANEL_API_KEY=

# ── Landing-page cache cron secret ────────────────────────────
# Required by /api/cron/landing-sync (Vercel Cron sends this as
# Authorization: Bearer <CRON_SECRET>). Generate with:
#   openssl rand -base64 32
# When unset (e.g. local dev), the cron route accepts unauthenticated
# GETs so you can hit it from a browser to test. ALWAYS set this in prod.
CRON_SECRET=

# ── Promotions corpus for the chat agent ──────────────────────
# Required by GET /api/corpus/promotions (sent as x-api-key). Generate with:
#   openssl rand -base64 32
# A key of its OWN — never the MSDB AI_API_KEY. Unlike CRON_SECRET, when this
# is unset the route REFUSES every request (503); it never falls open.
# See docs/promotions-corpus-endpoint.md §7 for the Vercel + Secret Manager steps.
CORPUS_API_KEY=

# ── Obfuscated admin entry token ──────────────────────────────
# /admin returns 404 for unauthenticated visitors UNLESS they hit it
# with `?knock=<this token>`, which redirects them to /admin/login and
# sets a short-lived cookie so subsequent /admin/login navigations work
# without the token in the URL. This is obfuscation, not security —
# the real auth gate is still NextAuth. Generate with:
#   node -e "console.log(require('crypto').randomBytes(18).toString('base64url'))"
ADMIN_ENTRY_TOKEN=

# ── Cloudinary (image uploads: banners, articles, logos) ──────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_FOLDER=9exp-genesis

# ── Postmark (transactional email: registration confirmations) ──
POSTMARK_SERVER_TOKEN=
POSTMARK_FROM_EMAIL=no-reply@9experttraining.com
# NOTE: declared but UNUSED — postmark.js sends a bare `From: <address>` and
# never composes a display name. Left in place rather than deleted because
# wiring it up is a real (small) improvement someone may still want.
POSTMARK_FROM_NAME=9Expert Training
# Used ONLY by the masterclass senders, which still send their own admin email
# (that admin mail gets no CC/BCC — its recipient IS the team). The public /
# in-house / paid-receipt paths no longer read this at all — their internal
# copies come from the per-flow lists below.
POSTMARK_ADMIN_EMAIL=pirasak.s@9expert.co.th

# ── Internal copies: PER FLOW, comma-separated ─────────────────────
# Which variable a send reads is decided in src/lib/email/recipients.js; the
# addresses live here (and in Vercel). Each is a comma-separated list — trimmed,
# empties dropped, de-duplicated case-insensitively, and an address already in
# CC is removed from BCC. Empty or unset = that header is omitted; the sender
# logs the variable name at INFO so a missing value shows up in the logs
# instead of silently dropping the copy. Nothing on the Postmark side can do
# this: a Template stores Subject + HTML + Text and has no Cc/Bcc field.
#
# The old app-wide POSTMARK_CC_EMAILS / POSTMARK_BCC_EMAILS pair is RETIRED and
# no longer read anywhere — every flow copied the same people.
#
# Public registration — the quote confirmation AND the paid receipt (CC).
POSTMARK_CC_PUBLIC_EMAILS=
# Public registration — the quote confirmation AND the paid receipt (BCC).
POSTMARK_BCC_PUBLIC_EMAILS=
# In-house quote request (CC).
POSTMARK_CC_INHOUSE_EMAILS=
# In-house quote request (BCC).
POSTMARK_BCC_INHOUSE_EMAILS=
# Bundle quote request (CC).
POSTMARK_CC_BUNDLE_EMAILS=
# Bundle quote request (BCC).
POSTMARK_BCC_BUNDLE_EMAILS=
# Career Path application acknowledgement (CC).
POSTMARK_CC_CAREERPATH_EMAILS=
# Career Path application acknowledgement (BCC).
POSTMARK_BCC_CAREERPATH_EMAILS=
# Masterclass — the quote confirmation AND the paid receipt (CC).
POSTMARK_CC_MASTERCLASS_EMAILS=
# Masterclass — the quote confirmation AND the paid receipt (BCC).
POSTMARK_BCC_MASTERCLASS_EMAILS=
# Masterclass PAID RECEIPT ONLY — added on top of POSTMARK_BCC_MASTERCLASS_EMAILS
# (the people who need to see money arrive, not every quote). No CC counterpart.
POSTMARK_BCC_MASTERCLASS_PAYMENT_EMAILS=

# ── Postmark Template Aliases ─────────────────────────────────────
# THE ROLLOUT RULE, per template:
#   blank  → that flow sends the hard-coded HTML in src/lib/email/templates/
#            and logs at info. This is the switch, not a failure.
#   set    → that flow renders subject AND body from the Postmark Template.
#            If the send comes back non-2xx (a 422 means the alias does not
#            exist on the server) it logs at ERROR naming the alias and the
#            status, then falls back to the HTML so the customer still gets
#            their mail. Watch the logs after flipping one on.
#
# Masterclass (out of scope for the template migration; these already ship)
POSTMARK_TEMPLATE_ALIAS_MC_PAID=masterclass-payment
POSTMARK_TEMPLATE_ALIAS_MC_QUOTE=masterclass-quote
# Public registration — confirmation, then the paid receipt
POSTMARK_TEMPLATE_ALIAS_REG_USER=public-quote
POSTMARK_TEMPLATE_ALIAS_PAID_USER=reg-paid-receipt
# In-house — quote-request acknowledgement
POSTMARK_TEMPLATE_ALIAS_INHOUSE_USER=inhouse-quote
# Bundle — quotation-request confirmation. Was shipping in code and MISSING from
# this file, so a fresh checkout silently took the hard-coded HTML path.
POSTMARK_TEMPLATE_ALIAS_REG_BUNDLE=bundle-quote
# Career Path — application acknowledgement.
#
# UNLIKE EVERY ALIAS ABOVE, LEAVING THIS BLANK SENDS NOTHING AT ALL. The others
# fall back to a hard-coded HTML body because they were already mailing customers
# before the templates existed; Career Path has never sent a mail, so there is no
# fallback body to write and an unset alias is the status quo rather than a
# regression. It logs at INFO and stops.
POSTMARK_TEMPLATE_ALIAS_REG_CAREERPATH=careerpath-quote

# ── Site metadata ─────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=9Expert Training

# ── Webhook receiver (MSDB → Genesis) ─────────────────────────
# Shared HMAC secret used to verify incoming POSTs at
# /api/webhooks/msdb. MUST equal MSDB's WEBHOOK_DEFAULT_SECRET.
# Generate with:
#   openssl rand -hex 32
MSDB_WEBHOOK_SECRET=

# ── Omise (online card / PromptPay QR payments) ───────────────
# Phase 1: use TEST keys (pkey_test_… / skey_test_…). Swap to live
# keys only at production deploy. Get keys from the Omise dashboard.
#
# NEXT_PUBLIC_OMISE_PUBLIC_KEY is exposed to the browser on purpose —
# Omise.js tokenizes the card client-side so raw card data never hits
# our server. The secret key stays server-only.
OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx
OMISE_SECRET_KEY=skey_test_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_OMISE_PUBLIC_KEY=pkey_test_xxxxxxxxxxxxxxxxxxxx
# Shared secret you set when creating the webhook endpoint in Omise.
OMISE_WEBHOOK_SECRET=
OMISE_WEBHOOK_FORWARD_URL=
#
# Unlocks /api/registration/public/dev-mark-paid to simulate a paid
# webhook (e.g. to complete test-mode PromptPay charges, which Omise
# never auto-completes). The endpoint returns 403 unless this is set to
# exactly "true". See docs/payment-testing.md.
# SECURITY: set only during active test sessions — never leave it on in
# production. Remove it from Vercel env vars when done testing.
# PAYMENT_TEST_MODE=false
#
# Set to 'true' (must match PAYMENT_TEST_MODE) to show the dev pay shortcut
# button in the UI on any environment. Remove after testing.
NEXT_PUBLIC_PAYMENT_TEST_MODE=
